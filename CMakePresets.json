{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug build with warnings as errors",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPBP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Optimised build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug build with address and undefined sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPBP_SANITIZE_ADDRESS": "ON",
        "CPPBP_SANITIZE_UNDEFINED": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Debug build with the thread sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPBP_SANITIZE_THREAD": "ON"
      }
    },
    {
      "name": "tidy",
      "inherits": "debug",
      "displayName": "Debug build that runs clang-tidy as it compiles",
      "cacheVariables": {
        "CPPBP_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-libc++",
      "inherits": "debug",
      "displayName": "Debug build with clang against libc++",
      "description": "The way out when the libstdc++ clang picks up by default is missing something. Needs libc++-dev and libc++abi-dev, and produces objects that do not link against libstdc++ ones.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "tidy", "configurePreset": "tidy" },
    { "name": "clang-libc++", "configurePreset": "clang-libc++" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "clang-libc++", "inherits": "base", "configurePreset": "clang-libc++" }
  ]
}
